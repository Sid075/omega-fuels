# ==============================================================================
# OMEGA FUELS — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Supabase Public Configuration (Exposed to browser via Next.js NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Supabase Server-Only Secret (NEVER expose to browser client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-admin-operations

# Application Station Metadata
NEXT_PUBLIC_STATION_NAME="OMEGA FUELS - Main Highway Station"
NEXT_PUBLIC_STATION_CODE="OF-01"

# Application URL (for OAuth / Auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication Session Secret (Fallback / local testing)
AUTH_SECRET=omega_fuels_secure_jwt_session_secret_3874928374982374
